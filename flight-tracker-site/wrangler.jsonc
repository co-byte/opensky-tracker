/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flight-tracker-site",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-16",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow the Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"FLIGHT_CACHE_TTL_SECONDS": 300
	},
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
		"directory": "./public/",
		"not_found_handling": "single-page-application"
	},
	/**
	 * Secrets Store (account-level secrets)
	 * https://developers.cloudflare.com/secrets-store/integrations/workers/
	 *
	 * `wrangler dev` cannot read these. Create a local copy of each secret with:
	 * npx wrangler secrets-store secret create <store_id> --name <secret_name> --scopes workers
	 */
	"secrets_store_secrets": [
		{
			"binding": "DATABRICKS_ACCOUNT_ID",
			"store_id": "646b3fab3a7c4c02bd0527f04dff5274",
			"secret_name": "DATABRICKS_ACCOUNT_ID"
		},
		{
			"binding": "DATABRICKS_DEPLOYMENT_NAME",
			"store_id": "646b3fab3a7c4c02bd0527f04dff5274",
			"secret_name": "DATABRICKS_DEPLOYMENT_NAME"
		},
		{
			"binding": "DATABRICKS_WAREHOUSE_ID",
			"store_id": "646b3fab3a7c4c02bd0527f04dff5274",
			"secret_name": "DATABRICKS_WAREHOUSE_ID"
		},
		{
			"binding": "DATABRICKS_CLIENT_ID",
			"store_id": "646b3fab3a7c4c02bd0527f04dff5274",
			"secret_name": "DATABRICKS_CLIENT_ID"
		},
		{
			"binding": "DATABRICKS_CLIENT_SECRET",
			"store_id": "646b3fab3a7c4c02bd0527f04dff5274",
			"secret_name": "DATABRICKS_CLIENT_SECRET"
		}
	],
	/**
	 * KV (caches the latest flight state, so page loads do not each query the warehouse)
	 * https://developers.cloudflare.com/kv/get-started/
	 */
	"kv_namespaces": [
		{
			"binding": "FLIGHT_CACHE",
			"id": "1e82c18c98e4455392a6deb44f400014"
		}
	],
	/**
	 * Workers AI (writes the one-sentence summary of a selected aircraft)
	 * https://developers.cloudflare.com/workers-ai/get-started/workers-wrangler/
	 */
	"ai": {
		"binding": "AI"
	}
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
